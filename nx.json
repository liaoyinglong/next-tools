{
  "$schema": "node_modules/nx/schemas/nx-schema.json",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["test", "build"]
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/src/**"],
    "testInput": [
      "{projectRoot}/{src,test,tests}/**/*.{spec,test}.{ts,tsx}",
      "{projectRoot}/**/*.test-d.{ts,tsx}"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/out"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["testInput"]
    }
  },
  "useInferencePlugins": false
}
