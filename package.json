{
  "name": "next-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for @dune2 packages: tools, cli, babel, vite",
  "keywords": [
    "monorepo",
    "turborepo"
  ],
  "license": "ISC",
  "author": "",
  "scripts": {
    "build": "turbo run build --filter=\"@dune2/*\"",
    "changeset": "changeset",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "graph": "turbo run build --graph",
    "lint": "oxlint packages docs example --deny-warnings",
    "release": "pnpm test && changeset version && changeset publish",
    "release:workflow": "gh workflow run .github/workflows/release.yaml",
    "test": "turbo run test --filter=\"@dune2/*\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "^20.5.3",
    "lefthook": "^2.1.0",
    "oxfmt": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
