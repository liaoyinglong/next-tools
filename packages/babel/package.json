{
  "name": "@dune2/babel",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/babel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./createStore": {
      "types": "./dist/createStore.d.mts",
      "import": "./dist/createStore.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "tsc --diagnostics",
    "build": "tsdown --clean --splitting",
    "build-fast": "pnpm run build --no-dts",
    "dev": "pnpm run build-fast --watch",
    "lint": "tsc --diagnostics --noEmit",
    "test": "vitest run",
    "test:u": "vitest -u"
  },
  "dependencies": {
    "@babel/types": "^8.0.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@babel/traverse": "^8.0.4",
    "@types/debug": "catalog:",
    "oxfmt": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
