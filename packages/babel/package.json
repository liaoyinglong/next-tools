{
  "name": "@dune2/babel",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/babel"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "tsc --diagnostics",
    "build": "tsup --clean --splitting",
    "build-fast": "pnpm run build --no-dts",
    "dev": "pnpm run build-fast --watch",
    "test": "vitest run",
    "test:update": "vitest -u"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/generator": "^7.25.0",
    "@babel/plugin-syntax-typescript": "^7.24.7",
    "@babel/types": "^7.25.2",
    "@types/babel__core": "^7.20.1",
    "@types/babel__generator": "^7",
    "@types/debug": "4.1.7",
    "babel-plugin-react-compiler": "0.0.0-experimental-7449567-20240905",
    "fast-glob": "^3.3.2",
    "tsup": "8"
  },
  "publishConfig": {
    "access": "public"
  }
}
