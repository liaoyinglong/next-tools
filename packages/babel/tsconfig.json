{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "sourceMap": true,
    "declaration": true,
    "outDir": "dist",
    "noEmit": true,
    "moduleResolution": "Node",
    "strictNullChecks": true,
    "stripInternal": true
