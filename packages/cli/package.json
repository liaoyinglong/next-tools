{
  "name": "@dune2/cli",
  "version": "1.1.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/cli"
  },
  "bin": {
    "dune": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs"
    },
    "./normalizeConfig": {
      "import": "./dist/normalizeConfig.mjs"
    },
    "./prettier": {
      "import": "./dist/prettier.mjs",
      "require": "./dist/prettier.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --splitting --clean",
    "dev": "pnpm run build --watch",
    "lint": "tsc --diagnostics --noEmit",
    "test": "vitest run",
    "test:u": "vitest -u"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12",
    "cac": "^6.7.14",
    "debug": "^4.3.4",
    "enquirer": "^2.3.6",
    "es-toolkit": "^1",
    "jiti": "^2.4.2",
    "json-schema-to-typescript": "15.0.3",
    "p-map": "^7.0.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "openapi-types": "^12.0.2",
    "prettier": "^3",
    "tsdown": "^0.19.0"
  }
}
