{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "sourceMap": true,
    "declaration": true,
    "outDir": "dist",
    "noEmit": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "strict": true,
    "stripInternal": true,
    "lib": ["es2017"],
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "tsdown.config.ts"],
  "exclude": ["node_modules", "tests/**/fixtures"]
}
