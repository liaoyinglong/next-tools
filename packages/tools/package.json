{
  "name": "@dune2/tools",
  "version": "1.1.4",
  "description": "",
  "keywords": [
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/tools"
  },
  "license": "ISC",
  "author": "",
  "exports": {
    "./factory/*": "./src/factory/*.tsx",
    "./numbro": "./src/numbro/index.ts",
    "./rq": {
      "react-server": "./src/rq/index.react-server.ts",
      "import": "./src/rq/index.ts",
      "require": "./src/rq/index.ts"
    },
    "./rq/*": "./src/rq/*.ts",
    "./shared": "./src/shared/index.ts",
    "./shared/*": "./src/shared/*.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/*": "./src/storage/*.ts",
    "./store": "./src/store/index.ts",
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --diagnostics",
    "test": "vitest run --typecheck",
    "test:u": "vitest -u",
    "typecheck": "vitest run --typecheck.only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "bignumber.js": "^9.1.2",
    "es-toolkit": "^1",
    "js-cookie": "^3.0.5",
    "store2": "^2.14.3",
    "valtio": "^2"
  },
  "devDependencies": {
    "@types/js-cookie": "3.0.3",
    "react": "^19"
  },
  "publishConfig": {
    "access": "public"
  }
}
