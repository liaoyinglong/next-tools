{
  "name": "@dune2/tools",
  "version": "1.4.0",
  "description": "React utilities: react-query request builder, storage, valtio store, number formatting",
  "keywords": [
    "numbro",
    "react",
    "react-query",
    "storage",
    "valtio"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/tools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./factory/*": {
      "types": "./dist/factory/*.d.ts",
      "import": "./dist/factory/*.js"
    },
    "./numbro": {
      "types": "./dist/numbro.d.ts",
      "import": "./dist/numbro.js"
    },
    "./rq": {
      "react-server": {
        "types": "./dist/rq/index.react-server.d.ts",
        "import": "./dist/rq/index.react-server.js"
      },
      "types": "./dist/rq/index.d.ts",
      "import": "./dist/rq/index.js"
    },
    "./rq/*": {
      "types": "./dist/rq/*.d.ts",
      "import": "./dist/rq/*.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./storage/*": {
      "types": "./dist/storage/*.d.ts",
      "import": "./dist/storage/*.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "lint": "tsc --diagnostics",
    "test": "vitest run --typecheck",
    "test:u": "vitest -u",
    "typecheck": "vitest run --typecheck.only"
  },
  "dependencies": {
    "bignumber.js": "^11.1.5",
    "es-toolkit": "catalog:",
    "js-cookie": "^3.0.5",
    "store2": "^2.14.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "3.0.6",
    "@types/react": "^19.2.13",
    "happy-dom": "^20.5.3",
    "react": "catalog:",
    "tsdown": "catalog:",
    "valtio": "^2.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18.0.0 || ^19.0.0",
    "valtio": "^2.3.0"
  }
}
