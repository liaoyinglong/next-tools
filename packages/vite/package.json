{
  "name": "@dune2/vite",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoyinglong/next-tools.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "tsc --diagnostics",
    "build": "tsdown --clean --splitting",
    "build-fast": "pnpm run build --no-dts",
    "dev": "pnpm run build-fast --watch",
    "lint": "tsc --diagnostics",
    "test": "vitest run",
    "test:u": "vitest -u"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.44.1",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@dune2/test-utils": "workspace:*",
    "oxfmt": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
